using Gtk 4.0;
using Adw 1;

template $QuizEditorDialog: Adw.Dialog {
  title: _("Quiz Editor");
  content-height: 640;
  content-width: 720;

  Adw.ToolbarView {
    [top]
    HeaderBar {
      title-widget: Adw.WindowTitle editor_title {
        title: _("Quiz Editor");
      };

      [start]
      Button create_button {
        label: _("Create");

        styles [
          "suggested-action",
        ]

        clicked => $on_create_quiz();
      }
    }

    content: Gtk.ScrolledWindow {
      vexpand: true;
      hscrollbar-policy: never;

      child: Adw.Clamp {
        margin-top: 24;
        margin-bottom: 24;
        margin-start: 12;
        margin-end: 12;

        child: Gtk.Box quiz_editor {
          orientation: vertical;
          spacing: 18;

          Adw.PreferencesGroup {
            title: _("Quiz");
            description: _("Set the quiz title.");

            Adw.EntryRow quiz_title {
              title: _("Quiz Title");
              changed => $on_form_changed();
            }
          }

          Gtk.Box {
            orientation: vertical;
            margin-top: 4;
            spacing: 6;

            Gtk.Box {
              spacing: 6;

              Label {
                label: _("Questions");
                hexpand: true;
                xalign: 0;

                styles [
                  "heading",
                ]
              }

              Button {
                icon-name: "list-add-symbolic";
                tooltip-text: _("Add Question");

                styles [
                  "flat",
                ]

                clicked => $on_add_question_clicked();
              }
            }

            Separator {}
          }
        };
      };
    };
  }
}
